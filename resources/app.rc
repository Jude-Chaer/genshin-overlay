#include <windows.h>

1 ICON "icon.ico"

// the zoom bar as it looks in a 2160 high game, MapTracking::loadZoomTemplate
ZOOMBAR_TEMPLATE RCDATA "zoombar_template.png"

1 VERSIONINFO
FILEVERSION 0,0,0,0
PRODUCTVERSION 0,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILESUBTYPE VFT2_UNKNOWN
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Pocket Esoptron"
            VALUE "ProductName", "Pocket Esoptron"
            VALUE "OriginalFilename", "PocketEsoptron.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
